{
  "name": "ev-charging",
  "version": "1.0.0",
  "description": "Blockchain-based EV Charging System",
  "main": "backend/server.js",
  "scripts": {
    "start": "bun backend/server.js",
    "dev": "concurrently \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:all": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\" \"bun run ai\"",
    "dev:frontend": "cd frontend && bun run dev",
    "dev:backend": "cd backend && bun run dev",
    "ai": "cd ai && uv run uvicorn app:app --host 0.0.0.0 --port 8000 --reload",
    "iot": "cd iot && uv run python simulator.py",
    "seed": "cd backend && bun run scripts/seed.js",
    "compile:contracts": "cd hardhat && bunx hardhat compile",
    "deploy:contracts": "cd hardhat && bunx hardhat run scripts/deploy.js --network amoy"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.1",
    "express": "^4.19.2",
    "mongoose": "^8.4.4",
    "mqtt": "^5.7.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.1",
    "nodemon": "^3.1.4",
    "@nomicfoundation/hardhat-toolbox": "^3.0.0",
    "hardhat": "^2.22.0"
  }
}